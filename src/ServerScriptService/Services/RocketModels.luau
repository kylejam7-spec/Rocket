    local b = t.build
    local y = mount(t.infra, 64, 6, 44, Color3.fromRGB(70, 76, 90))
    for _, edge in { { V(0, 6.1, 22), V(64, 0.2, 0.6) }, { V(0, 6.1, -22), V(64, 0.2, 0.6) }, { V(32, 6.1, 0), V(0.6, 0.2, 44) }, { V(-32, 6.1, 0), V(0.6, 0.2, 44) } } do
        block(t.infra, "MountTrim", edge[1], edge[2], C.cyan, { material = "Neon" })
    end
    block(t.infra, "FlameTrench", V(0, 6.05, 0), V(28, 0.1, 28), C.black)
    floodlights(t.infra, { Vector2.new(-44, 28), Vector2.new(-44, -28), Vector2.new(44, 32) }, 22)
    local base = y
    engines(b, "CoreEngine", 0, 0, { Vector2.zero, table.unpack(circle(8, 7.5, 0)) }, y, 4, 4.5)
    y = cyl(b, "ThrustSkirt", 0, 0, y + 4, 9, 24, C.dark, { material = "Metal" })
    y = cyl(b, "HeatShieldRing", 0, 0, y, 0.6, 24.6, C.cyan, { material = "Neon" })
    y = stack(b, "CoreTank", 0, 0, y, 6, 12, 24, C.white)
    cyl(b, "FoilBand", 0, 0, 55, 1.4, 24.4, C.gold, { minVariant = 2, material = "Foil" })
    y = cyl(b, "CoreBand", 0, 0, y, 1, 24.6, C.cyan, { material = "Neon" })
    y = stack(b, "CoreUpperTank", 0, 0, y, 4, 12, 24, C.white)
    block(b, "CyanStripeL", V(-12.1, 116, 0), V(0.4, 40, 1.2), C.cyan, { minVariant = 3, material = "Neon" })
    block(b, "CyanStripeR", V(12.1, 116, 0), V(0.4, 40, 1.2), C.cyan, { minVariant = 3, material = "Neon" })
    for _, side in { -1, 1 } do
        local x = side * 19.5
        local tag = side < 0 and "L" or "R"
        engines(b, "BoosterEngine" .. tag, x, 0, circle(3, 2.8, math.rad(90)), base, 3, 4)
        local top = stack(b, "Booster" .. tag, x, 0, base + 3, 6, 11, 13, C.offwhite)
        cyl(b, "BoosterTrim" .. tag, x, 0, top - 0.6, 0.6, 13.4, C.cyan, { material = "Neon" })
