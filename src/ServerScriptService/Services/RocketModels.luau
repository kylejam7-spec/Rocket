        nose(b, "BoosterNose" .. tag, x, 0, top, { { 11, 4 }, { 8.5, 4 }, { 5.5, 3 }, { 3, 2 } }, C.white)
        for _, strutY in { 16, 70 } do
            block(b, "Strut" .. tag, V(side * 12.75, strutY, 0), V(1.8, 1.6, 3), C.dark, { material = "Metal" })
        end
    end
    y = cyl(b, "Interstage", 0, 0, y, 2, 24.6, C.dark, { material = "Metal" })
    y = stack(b, "UpperStage", 0, 0, y, 2, 8, 20, C.white)
    y = cyl(b, "TransferRing", 0, 0, y, 0.8, 20.4, C.cyan, { material = "Neon" })
