    gauge(t.fuel, 12, 22, 139, 16, 3.6)
    t.boarding = { cframe = CFrame.new(0, 0.1, 27), size = V(24, 0.2, 10) }
    t.height = y
    return t
end

-- Per-tier enlargement: ~318, 420, 522, 621 and 756 studs tall once scaled. Rockets are
-- huge so one player's small delivery still visibly grows the fill (3x the 2026-10-16 size).
Models.Scale = { 6, 5.4, 4.8, 4.35, 3.9 }
for tier, k in Models.Scale do
    local author = Models[tier]
    Models[tier] = function()
        local t = author()
        for _, list in { t.build, t.fuel, t.infra } do
            for _, spec in list do
                spec.cframe = spec.cframe.Rotation + spec.cframe.Position * k
                spec.size *= k
                if spec.light then spec.light.range *= k end
            end
        end
        -- The boarding zone stays a thin floor marker; only its footprint grows.
        t.boarding.cframe = CFrame.new(t.boarding.cframe.Position * V(k, 1, k))
        t.boarding.size *= V(k, 1, k)
        t.height *= k
        return t
    end
end

return Models
