    y = nose(b, "Nose", 0, 0, y, { { 15, 4 }, { 12, 4 }, { 9, 4 }, { 6, 3 }, { 3, 2 } }, C.white)
    ball(b, "NoseTip", 0, 0, y + 0.6, 2.4, C.cyan, { material = "Neon" })
