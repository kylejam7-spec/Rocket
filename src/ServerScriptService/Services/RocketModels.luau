--[[
    Geometry for the five rocket tiers, as plain data (no instances are made here).

    Coordinates are relative to the launch origin: the centre of the permanent
    launch pad, on its top surface. +Y is up; +Z faces the depots and the
    rest of the map, so fuel gauges and windows sit on the +Z side.

    Models[tier]() returns
        build    rocket segments; RocketBuildService fills them lowest-first, so list
                 order only breaks ties between segments starting at the same height
        fuel     fuel-gauge cells, filled bottom-up by fuelling progress
        infra    static launch-complex pieces for this tier (mount, lights). The two
                 climbing ramps are generated by RocketBuildService from the rocket's
                 bounds on both the -X and +X flanks, so keep both flanks and the pad in
                 front of the mount clear (floodlights stand outside the ramps).
        boarding { cframe, size } crew boarding zone on the pad in front of the rocket
        height   approximate top of the rocket, studs above the pad

    Segment fields: name, shape (Block|Cylinder|Ball|Wedge), cframe, size, color,
    material (Enum.Material name, default SmoothPlastic), engine (exhaust emitter),
    minVariant (2 or 3: only on the 2nd/3rd cycle of the tier), light.

    Tiers are authored below at their original size; Models.Scale then enlarges each
    one so a full 50-player server can climb the ramps and hull together. Smaller
    tiers scale more because their short ramps were the bottleneck.

    Once scaled, every tier must fit the reserved launch complex: |x| <= 174, |z| <= 132.
    The ramps themselves reach |x| ~139 on Tier 5.
]]
local V = Vector3.new
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))
local C = {
    white = Color3.fromRGB(236, 239, 243), offwhite = Color3.fromRGB(214, 219, 226),
    grey = Color3.fromRGB(120, 128, 140), dark = Color3.fromRGB(52, 56, 64), black = Color3.fromRGB(28, 30, 35),
    engine = Color3.fromRGB(40, 42, 48), red = Color3.fromRGB(216, 91, 73), orange = Color3.fromRGB(240, 140, 50),
    window = Color3.fromRGB(110, 200, 255), panel = Color3.fromRGB(40, 70, 130), gold = Color3.fromRGB(226, 182, 80),
    cyan = Color3.fromRGB(80, 230, 255), steel = Color3.fromRGB(150, 158, 170), concrete = Color3.fromRGB(105, 112, 124),
    tower = Color3.fromRGB(200, 70, 50), fuelEmpty = Color3.fromRGB(45, 40, 36),
}
local Models = { Colors = C }

local function with(spec, extra)
    if extra then for key, value in extra do spec[key] = value end end
    return spec
end
-- Vertical cylinder whose base sits at y; returns its top.
local function cyl(list, name, x, z, y, h, d, color, extra)
    table.insert(list, with({ name = name, shape = "Cylinder", cframe = CFrame.new(x, y + h / 2, z) * UPRIGHT, size = V(h, d, d), color = color }, extra))
    return y + h
end
local function block(list, name, position, size, color, extra)
    table.insert(list, with({ name = name, shape = "Block", cframe = CFrame.new(position), size = size, color = color }, extra))
end
local function ball(list, name, x, z, y, d, color, extra)
    table.insert(list, with({ name = name, shape = "Ball", cframe = CFrame.new(x, y, z), size = V(d, d, d), color = color }, extra))
end
local function stack(list, name, x, z, y, rings, h, d, color, extra)
    for index = 1, rings do y = cyl(list, name .. index, x, z, y, h, d, color, extra) end
    return y
end
-- Stepped nose cone: steps = { {diameter, height}, ... } from the base up.
local function nose(list, name, x, z, y, steps, color, extra)
    for index, step in steps do y = cyl(list, name .. index, x, z, y, step[2], step[1], color, extra) end
    return y
end
local function circle(count, radius, offset)
    local points = {}
    for index = 1, count do
        local angle = (offset or 0) + (index - 1) * 2 * math.pi / count
        table.insert(points, Vector2.new(math.cos(angle) * radius, math.sin(angle) * radius))
    end
    return points
end
local function engines(list, name, cx, cz, points, y, h, d, extra)
    for index, point in points do
        cyl(list, name .. index, cx + point.X, cz + point.Y, y, h, d, C.engine, with({ engine = true, material = "DiamondPlate" }, extra))
    end
end
-- Wedge fins: the wedge's full-height face (+Z) points at the body, slope outward.
local function fins(list, name, cx, cz, radius, yBottom, height, length, thickness, color, count, extra)
    for index, point in circle(count or 4, 1, math.rad(45)) do
        local direction = V(point.X, 0, point.Y)
        local position = V(cx, yBottom + height / 2, cz) + direction * (radius + length / 2)
        table.insert(list, with({ name = name .. index, shape = "Wedge", cframe = CFrame.lookAt(position, position + direction),
            size = V(thickness, height, length), color = color }, extra))
    end
end
-- Blocks placed around a cylinder surface, facing outward (windows, panels).
local function around(list, name, count, radius, y, size, color, offset, extra)
    for index, point in circle(count, radius, offset) do
        local position = V(point.X, y, point.Y)
        table.insert(list, with({ name = name .. index, shape = "Block",
            cframe = CFrame.lookAt(position, position + V(point.X, 0, point.Y)), size = size, color = color }, extra))
    end
end
-- Fuel gauge: a column of cells on the +Z face of the core tank.
local function gauge(list, radius, y0, y1, count, width)
    local step = (y1 - y0) / count
    for index = 1, count do
        block(list, "FuelCell" .. index, V(0, y0 + (index - 0.5) * step, radius + 0.45), V(width, step * 0.72, 0.3), C.fuelEmpty)
    end
end
local function mount(list, width, height, depth, color)
    block(list, "LaunchMount", V(0, height / 2, 0), V(width, height, depth), color or C.concrete, { material = "Concrete" })
    return height
end
local function floodlights(list, positions, height)
    for _, position in positions do
        block(list, "FloodPole", V(position.X, height / 2, position.Y), V(1, height, 1), C.steel, { material = "Metal" })
        block(list, "FloodLamp", V(position.X, height + 0.6, position.Y), V(3, 1.2, 3), Color3.fromRGB(255, 245, 210),
            { material = "Neon", light = { color = Color3.fromRGB(255, 240, 200), range = 40, brightness = 1.5 } })
    end
end

-- Tier 1 — Starter Rocket (~53 studs): one engine, one tank, capsule.
Models[1] = function()
    local t = { build = {}, fuel = {}, infra = {} }
    local b = t.build
    local y = mount(t.infra, 16, 2, 16)
    cyl(b, "EngineBell", 0, 0, y, 2.5, 7, C.engine, { engine = true, material = "DiamondPlate" })
    cyl(b, "EngineThroat", 0, 0, y + 2.5, 1.5, 5, C.dark)
    y = cyl(b, "EngineSection", 0, 0, y + 4, 5, 10, C.grey, { material = "Metal" })
    fins(b, "Fin", 0, 0, 5, 2.5, 9, 4.5, 0.8, C.red)
    cyl(b, "SidePodL", -6.4, 0, 3, 7, 2.4, C.grey, { minVariant = 3 })
    cyl(b, "SidePodR", 6.4, 0, 3, 7, 2.4, C.grey, { minVariant = 3 })
    engines(b, "PodNozzle", 0, 0, { Vector2.new(-6.4, 0), Vector2.new(6.4, 0) }, 2, 1, 1.8, { minVariant = 3 })
    y = stack(b, "Tank", 0, 0, y, 2, 6, 10, C.white)
    cyl(b, "TankStripeA", 0, 0, y - 0.4, 0.8, 10.3, C.orange, { minVariant = 2 })
    y = stack(b, "TankUpper", 0, 0, y, 2, 6, 10, C.white)
    cyl(b, "TankStripeB", 0, 0, y - 0.4, 0.8, 10.3, C.orange, { minVariant = 2 })
    y = cyl(b, "Interstage", 0, 0, y, 1.2, 10.4, C.dark)
    local capsule = y
    y = cyl(b, "Capsule", 0, 0, y, 5, 9, C.white)
    block(b, "Window", V(0, capsule + 2.5, 4.55), V(2, 1.4, 0.4), C.window, { material = "Neon" })
    y = nose(b, "Nose", 0, 0, y, { { 7.5, 3 }, { 6, 3 }, { 4.2, 2.5 }, { 2.4, 2 } }, C.red)
    ball(b, "NoseTip", 0, 0, y + 0.4, 1.6, C.red)
    gauge(t.fuel, 5, 12, 34, 8, 1.8)
    t.boarding = { cframe = CFrame.new(0, 0.1, 12.5), size = V(14, 0.2, 8) }
    t.height = y + 1.2
    return t
end

-- Tier 2 — Orbital Rocket (~78 studs): bigger engine, two tank sections, service module, escape tower.
Models[2] = function()
    local t = { build = {}, fuel = {}, infra = {} }
    local b = t.build
    local y = mount(t.infra, 22, 3, 22)
    for _, corner in circle(4, 9.5, math.rad(45)) do
        block(t.infra, "HoldDown", V(corner.X, 4, corner.Y), V(2, 2, 2), C.dark, { material = "Metal" })
    end
    cyl(b, "EngineBell", 0, 0, y, 3, 9, C.engine, { engine = true, material = "DiamondPlate" })
    cyl(b, "EngineThroat", 0, 0, y + 3, 1.5, 6.5, C.dark)
    y = cyl(b, "ThrustStructure", 0, 0, y + 4.5, 6, 12, C.grey, { material = "Metal" })
    fins(b, "Fin", 0, 0, 6, 3.5, 11, 5.5, 1, C.red)
    for index, point in circle(4, 7, 0) do
        cyl(b, "VernierPod" .. index, point.X, point.Y, 5, 5, 2.6, C.grey, { minVariant = 3 })
        cyl(b, "Vernier" .. index, point.X, point.Y, 3, 2, 2, C.engine, { minVariant = 3, engine = true })
    end
    y = stack(b, "LowerTank", 0, 0, y, 4, 6.5, 12, C.white)
    block(b, "RollMarkL", V(-6.05, 26, 0), V(0.4, 6.5, 4), C.black, { minVariant = 2 })
    block(b, "RollMarkR", V(6.05, 26, 0), V(0.4, 6.5, 4), C.black, { minVariant = 2 })
    y = cyl(b, "TankBand", 0, 0, y, 1, 12.4, C.black)
    y = stack(b, "UpperTank", 0, 0, y, 2, 6, 12, C.white)
    cyl(b, "UpperStripe", 0, 0, y - 6.4, 0.8, 12.3, C.orange, { minVariant = 2 })
    y = cyl(b, "Interstage", 0, 0, y, 1.5, 12.4, C.black)
    local service = y
    y = cyl(b, "ServiceModule", 0, 0, y, 4, 11, C.grey, { material = "Metal" })
    block(b, "SolarPanelL", V(-8.6, service + 2, 0), V(6, 3, 0.3), C.panel, { material = "Glass" })
    block(b, "SolarPanelR", V(8.6, service + 2, 0), V(6, 3, 0.3), C.panel, { material = "Glass" })
    local capsule = y
    y = cyl(b, "Capsule", 0, 0, y, 5, 10, C.white)
    block(b, "Window", V(0, capsule + 2.5, 5.05), V(2.2, 1.6, 0.4), C.window, { material = "Neon" })
    y = nose(b, "Nose", 0, 0, y, { { 8.5, 3 }, { 6.5, 3 }, { 4.5, 2.5 }, { 2.5, 2 } }, C.red)
    ball(b, "NoseTip", 0, 0, y + 0.4, 1.6, C.red)
    y = cyl(b, "EscapeTower", 0, 0, y + 0.4, 4, 0.7, C.steel, { material = "Metal" })
    gauge(t.fuel, 6, 15, 51, 10, 2.2)
    t.boarding = { cframe = CFrame.new(0, 0.1, 16), size = V(16, 0.2, 8) }
    t.height = y
    return t
end

-- Tier 3 — Heavy-Lift Rocket (~109 studs): three-engine core, two side boosters, upper stage.
Models[3] = function()
    local t = { build = {}, fuel = {}, infra = {} }
    local b = t.build
    local y = mount(t.infra, 40, 4, 30)
    floodlights(t.infra, { Vector2.new(-30, 18), Vector2.new(30, -12) }, 14)
    local base = y
    engines(b, "CoreEngine", 0, 0, circle(3, 3.2, math.rad(90)), y, 3, 4.5)
    y = cyl(b, "ThrustSection", 0, 0, y + 3, 7, 14, C.dark, { material = "Metal" })
    y = stack(b, "CoreTank", 0, 0, y, 5, 8, 14, C.white)
    cyl(b, "CoreStripe", 0, 0, 34, 1, 14.3, C.orange, { minVariant = 2 })
    y = cyl(b, "CoreBand", 0, 0, y, 1, 14.4, C.black)
    y = stack(b, "CoreUpperTank", 0, 0, y, 3, 8, 14, C.white)
    for _, side in { -1, 1 } do
        local x = side * 12
        local tag = side < 0 and "L" or "R"
        cyl(b, "BoosterEngine" .. tag, x, 0, base, 2.5, 5, C.engine, { engine = true, material = "DiamondPlate" })
        local top = stack(b, "Booster" .. tag, x, 0, base + 2.5, 4, 9, 8, C.offwhite)
        cyl(b, "BoosterStripe" .. tag, x, 0, 24, 1, 8.3, C.orange, { minVariant = 3 })
        top = nose(b, "BoosterNose" .. tag, x, 0, top, { { 6, 3 }, { 4, 3 }, { 2, 2 } }, C.red)
        for _, strutY in { 12, 40 } do
            block(b, "Strut" .. tag, V(side * 7.5, strutY, 0), V(1.4, 1.2, 2), C.dark)
        end
    end
    y = cyl(b, "Interstage", 0, 0, y, 2, 14.4, C.black)
    y = stack(b, "UpperStage", 0, 0, y, 2, 5, 12, C.white)
    local payload = y
    y = cyl(b, "PayloadSection", 0, 0, y, 4, 12, C.grey, { material = "Metal" })
    block(b, "Window", V(0, payload + 2, 6.05), V(2.6, 1.6, 0.4), C.window, { material = "Neon" })
    y = nose(b, "Fairing", 0, 0, y, { { 10, 3 }, { 8, 3 }, { 6, 3 }, { 4, 2 }, { 2, 2 } }, C.white)
    ball(b, "NoseTip", 0, 0, y + 0.4, 1.6, C.red)
    gauge(t.fuel, 7, 16, 78, 12, 2.6)
    t.boarding = { cframe = CFrame.new(0, 0.1, 19.5), size = V(18, 0.2, 9) }
    t.height = y + 1.2
    return t
end

-- Tier 4 — Super Heavy Rocket (~143 studs): 7-engine core, large boosters, three stages.
Models[4] = function()
    local t = { build = {}, fuel = {}, infra = {} }
    local b = t.build
    local y = mount(t.infra, 52, 5, 36)
    block(t.infra, "FlameTrench", V(0, 5.05, 0), V(20, 0.1, 20), C.black)
    floodlights(t.infra, { Vector2.new(-36, 22), Vector2.new(-36, -22), Vector2.new(36, 26) }, 18)
    local base = y
    engines(b, "CoreEngine", 0, 0, { Vector2.zero, table.unpack(circle(6, 5.6, 0)) }, y, 3.5, 4)
    y = cyl(b, "ThrustSection", 0, 0, y + 3.5, 8, 18, C.dark, { material = "Metal" })
    y = stack(b, "CoreTank", 0, 0, y, 6, 9, 18, C.white)
    cyl(b, "CoreStripe", 0, 0, 43, 1.2, 18.4, C.orange, { minVariant = 2 })
    y = cyl(b, "CoreBand", 0, 0, y, 1, 18.5, C.black)
    y = stack(b, "CoreUpperTank", 0, 0, y, 3, 9, 18, C.white)
    block(b, "RollMarkL", V(-9.05, 85, 0), V(0.4, 9, 6), C.black, { minVariant = 3 })
    block(b, "RollMarkR", V(9.05, 85, 0), V(0.4, 9, 6), C.black, { minVariant = 3 })
    for _, side in { -1, 1 } do
        local x = side * 15
        local tag = side < 0 and "L" or "R"
        engines(b, "BoosterEngine" .. tag, x, 0, circle(3, 2.2, math.rad(90)), base, 3, 3)
        local top = stack(b, "Booster" .. tag, x, 0, base + 3, 5, 10, 10, C.offwhite)
        top = nose(b, "BoosterNose" .. tag, x, 0, top, { { 8, 4 }, { 6, 3 }, { 3.5, 3 } }, C.red)
        for _, strutY in { 14, 54 } do
            block(b, "Strut" .. tag, V(side * 9.5, strutY, 0), V(1.6, 1.5, 2.5), C.dark)
        end
    end
    y = cyl(b, "Interstage", 0, 0, y, 2, 18.5, C.black)
    y = stack(b, "SecondStage", 0, 0, y, 2, 7, 15, C.white)
    cyl(b, "SecondStripe", 0, 0, y - 0.6, 1.2, 15.3, C.orange, { minVariant = 2 })
    y = cyl(b, "ThirdStage", 0, 0, y, 8, 12, C.offwhite)
    local capsule = y
    y = cyl(b, "Capsule", 0, 0, y, 5, 11, C.white)
    around(b, "Window", 3, 5.6, capsule + 2.5, V(2.4, 1.6, 0.4), C.window, math.rad(90), { material = "Neon" })
    y = nose(b, "Nose", 0, 0, y, { { 9, 3 }, { 7, 3 }, { 5, 3 }, { 3, 2 } }, C.red)
    ball(b, "NoseTip", 0, 0, y + 0.4, 1.8, C.red)
    y = cyl(b, "EscapeTower", 0, 0, y + 0.4, 5, 0.8, C.steel, { material = "Metal" })
    gauge(t.fuel, 9, 18, 97, 14, 3)
    t.boarding = { cframe = CFrame.new(0, 0.1, 23), size = V(20, 0.2, 10) }
    t.height = y
    return t
end

-- Tier 5 — Interplanetary Rocket (~194 studs): 9-engine core, two huge boosters,
