-- Run with tools/Test.ps1; no Roblox globals or test framework required.
local Rocket = require("../src/ServerScriptService/Services/RocketService")
local config = { Materials = { Metal = 2, Fuel = 1 } }
local rocket = Rocket.new(config, "cycle-1")
assert(not rocket:pickup(1, {}, 1), "Malformed material rejected")
assert(not rocket:pickup(1, "Unknown", 1), "Unknown material rejected")
assert(rocket:deliver(1) == 0, "Cannot deliver empty cargo")
assert(rocket:pickup(1, "Metal", 1))
assert(not rocket:pickup(1, "Metal", 1), "Capacity enforced")
assert(not rocket:pickup(1, "Fuel", 1), "Mixed cargo rejected")
assert(rocket:pickup(2, "Metal", 3))
assert(rocket:pickup(2, "Metal", 3))
assert(rocket:pickup(2, "Metal", 3))
assert(rocket:deliver(1) == 1)
assert(rocket:deliver(1) == 0, "Replay spends nothing")
assert(rocket:deliver(2) == 1, "Delivery clamps to remaining requirement")
assert(rocket.totals.Metal == 2)
assert(rocket.cargo[2].count == 2, "Excess cargo preserved until reset")
assert(rocket:deliver(2) == 0)
assert(rocket:pickup(1, "Fuel", 1))
assert(rocket:deliver(1) == 1)
assert(rocket.phase == "Boarding")
assert(not rocket:pickup(2, "Fuel", 1), "Wrong phase rejected")
assert(rocket:deliver(2) == 0)
assert(rocket:lockPassengers({ [1] = true }))
assert(not rocket:lockPassengers({ [2] = true }), "Lock is one-time")
rocket:forget(1)
assert(rocket.passengers[1], "Disconnect after lock keeps entitlement")
assert(not rocket.passengers[2], "Missed passenger gets no entitlement")
local second = Rocket.new(config, "cycle-2")
assert(second.phase == "Building" and second.totals.Metal == 0 and not next(second.cargo))
assert(rocket.contributions[1] == 2 and rocket.contributions[2] == 1)
print("PASS: two contributors, malformed/replayed/capped delivery, phase lock, disconnect, reset")
