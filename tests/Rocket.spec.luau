-- Run with tools/Test.ps1; no Roblox globals or test framework required.
local Rocket = require("../src/ServerScriptService/Services/RocketService")
local config = { Materials = { Metal = 4 } }
local rocket = Rocket.new(config, "cycle-1")
assert(not rocket:pickup(1, {}, 1), "Malformed material rejected")
assert(not rocket:pickup(1, "Unknown", 1), "Unknown material rejected")
assert(rocket:deliver(1) == 0, "Cannot deliver empty cargo")
assert(rocket:pickup(1, "Metal", 1))
assert(not rocket:pickup(1, "Metal", 1), "Capacity enforced")
assert(not rocket:pickup(1, "Fuel", 1), "Removed material rejected")
assert(rocket:pickup(2, "Metal", 3))
assert(rocket:pickup(2, "Metal", 3))
assert(rocket:pickup(2, "Metal", 3))
assert(not rocket:pickup(3, "Metal", 3), "Other players' cargo reserves remaining requirement")
assert(rocket:deliver(1) == 1)
assert(rocket:deliver(1) == 0, "Replay spends nothing")
assert(not rocket:pickup(1, "Metal", 3), "Delivered plus carried amount prevents excess pickup")
rocket:forget(2)
assert(rocket:pickup(1, "Metal", 3), "Disconnect releases reserved material")
assert(rocket:deliver(1) == 1)
assert(rocket:pickup(2, "Metal", 3))
assert(rocket:deliver(2) == 1)
assert(rocket.totals.Metal == 3)
assert(rocket:pickup(1, "Metal", 3), "With 3/4 delivered, exactly one more piece is allowed")
assert(not rocket:pickup(1, "Metal", 3), "Extra carrying capacity cannot exceed remaining need")
assert(not rocket:pickup(2, "Metal", 3), "Simultaneous competitor cannot reserve the final piece twice")
assert(rocket:deliver(1) == 1)
assert(not next(rocket.cargo), "Finishing the requirement leaves no stranded cargo")
assert(rocket:deliver(2) == 0)
assert(rocket.phase == "Boarding")
assert(not rocket:pickup(2, "Metal", 1), "Wrong phase rejected")
assert(rocket:deliver(2) == 0)
assert(rocket:lockPassengers({ [1] = true }))
assert(not rocket:lockPassengers({ [2] = true }), "Lock is one-time")
rocket:forget(1)
assert(rocket.passengers[1], "Disconnect after lock keeps entitlement")
assert(not rocket.passengers[2], "Missed passenger gets no entitlement")
local second = Rocket.new(config, "cycle-2")
assert(second.phase == "Building" and second.totals.Metal == 0 and not next(second.cargo))
assert(rocket.contributions[1] == 3 and rocket.contributions[2] == 1)
print("PASS: no excess pickup at 3/4, shared cargo reservations, disconnect release, delivery replay, phase lock, reset")
