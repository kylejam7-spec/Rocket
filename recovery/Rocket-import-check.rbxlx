  <Item class="ReplicatedStorage" referent="5">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
      <BinaryString name="SerializedOverrides">
      </BinaryString>
    </Properties>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Shared</string>
        <BinaryString name="SerializedOverrides">
        </BinaryString>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Config</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[return table.freeze({
    Materials = table.freeze({ Metal = 6, Fuel = 4 }),
    MaterialsPerSlotPerLaunch = 1,
    MaterialHoldSeconds = 0.05,
    BoardingSeconds = 20,
    LaunchSeconds = 4,
    RewardSeconds = 30,
    InteractionDistance = 10,
    ActionCooldown = 0.5,
    TrainingSeconds = 1,
    MaxLevel = 50,
    MaxPlanetBonus = 1000000,
    BaseSpeed = 16,
    SpeedPerLevel = 0.3,
    MaxSpeed = 32,
    MaxCapacity = 5,
    AdvancedGymCompletions = 1,
    Planet = table.freeze({ Id = "Meadow", StrengthBonus = 3, SpeedBonus = 3 }),
    -- Persistence stays off for reproducible, non-production Studio tests.
    PersistenceEnabled = false,
    DataStoreName = "RocketProfiles_v1_test",
    AutosaveSeconds = 30,
    LeaseSeconds = 120,
    RecentRewardLimit = 64,
})
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
      <BinaryString name="SerializedOverrides">
      </BinaryString>
    </Properties>
    <Item class="Script" referent="9">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <BinaryString name="SerializedOverrides">
        </BinaryString>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Config = require(ReplicatedStorage.Shared.Config)
local Rocket = require(script.Parent.Services.RocketService)
local Profiles = require(script.Parent.Services.ProfileService)

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local stateEvent = Instance.new("RemoteEvent")
stateEvent.Name = "StateUpdated"
stateEvent.Parent = remotes
local requestState = Instance.new("RemoteEvent")
requestState.Name = "RequestState"
requestState.Parent = remotes
local feedbackEvent = Instance.new("RemoteEvent")
feedbackEvent.Name = "Feedback"
feedbackEvent.Parent = remotes
remotes.Parent = ReplicatedStorage

local world = Instance.new("Folder")
world.Name = "RocketWorld"
local function part(name, position, size, color, className)
    local object = Instance.new(className or "Part")
    object.Name = name
    object.Anchored = true
    object.Position = position
    object.Size = size
    object.Color = color
    object.TopSurface = Enum.SurfaceType.Smooth
    object.BottomSurface = Enum.SurfaceType.Smooth
    object.Parent = world
    return object
end
local function label(object, text)
    local gui = Instance.new("BillboardGui")
    gui.Size = UDim2.fromOffset(260, 60)
    gui.StudsOffset = Vector3.new(0, 5, 0)
    gui.AlwaysOnTop = true
    gui.Parent = object
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.fromScale(1, 1)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = text
    textLabel.TextColor3 = Color3.new(1, 1, 1)
    textLabel.TextStrokeTransparency = 0.3
    textLabel.TextSize = 18
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Parent = gui
end
local prompts = {}
local function prompt(object, action, hold)
    local result = Instance.new("ProximityPrompt")
    result.ActionText = action
    result.ObjectText = object.Name
    result.MaxActivationDistance = Config.InteractionDistance
    result.HoldDuration = hold or 0
    result.RequiresLineOfSight = false
    result.KeyboardKeyCode = Enum.KeyCode.E
    result.Parent = object
    table.insert(prompts, result)
    return result
end

local expandMap = require(script.Parent.Services.MapExpansionService).build(part, label)
local mapCycle = 1
expandMap(mapCycle)
local spawn = part("Spawn", Vector3.new(0, 1, 36), Vector3.new(8, 1, 8), Color3.fromRGB(225, 230, 238), "SpawnLocation")
spawn.Neutral = true
label(spawn, "ROCKET • Train, gather, launch together")
local metal = part("Metal", Vector3.new(-24, 2, 12), Vector3.new(6, 4, 6), Color3.fromRGB(139, 166, 185))
local fuel = part("Fuel", Vector3.new(24, 2, 12), Vector3.new(6, 4, 6), Color3.fromRGB(245, 182, 71))
label(metal, "METAL • Pick up a piece")
label(fuel, "FUEL • Pick up a canister")
-- Horizontal, walkable chassis. Ghost hull slots become solid as players build.
local chassis = part("RocketChassis", Vector3.new(0, 1, -22), Vector3.new(38, 2, 12), Color3.fromRGB(70, 83, 103))
local boarding = part("CabinInterior", Vector3.new(0, 2.1, -22), Vector3.new(34, 0.2, 9), Color3.fromRGB(89, 210, 165))
boarding.Transparency = 0.35
boarding.CanCollide = false
label(chassis, "ROCKET TEMPLATE • Hold E at a matching outlined block")
local entrance = part("CabinEntrance", Vector3.new(-20, 0.5, -22), Vector3.new(4, 1, 9), Color3.fromRGB(89, 210, 165))
label(entrance, "BOARD INSIDE • Enter at this open end")
-- Permanent stairs let builders reach the roof without trapping the cabin entrance.
for index = 1, 6 do
    part("RoofStep" .. index, Vector3.new(-21 + index * 3, index, -32), Vector3.new(3, index * 2, 5), Color3.fromRGB(98, 111, 131))
end
local slots = {}
local function slot(id, material, position, size)
    local block = part(id, position, size, material == "Metal" and Color3.fromRGB(194, 211, 226) or Color3.fromRGB(245, 182, 71))
    block.Transparency = 0.78
    block.CanCollide = false
    block:SetAttribute("MaterialId", material)
    block:SetAttribute("Placed", false)
    local outline = Instance.new("SelectionBox")
    outline.Adornee = block
    outline.LineThickness = 0.05
    outline.Color3 = block.Color
    outline.Parent = block
    slots[id] = { part = block, material = material, outline = outline }
end
for index, x in {-9, 9} do
    slot("MetalLeft" .. index, "Metal", Vector3.new(x, 7, -28), Vector3.new(18, 10, 1))
    slot("MetalRight" .. index, "Metal", Vector3.new(x, 7, -16), Vector3.new(18, 10, 1))
    slot("MetalRoof" .. index, "Metal", Vector3.new(x, 12.5, -22), Vector3.new(18, 1, 13))
end
for index, z in {-27, -17} do
    slot("FuelEngine" .. index, "Fuel", Vector3.new(-20, 4, z), Vector3.new(4, 4, 3))
    slot("FuelNose" .. index, "Fuel", Vector3.new(20, 5, z), Vector3.new(4, 6, 3))
end
local nose = part("RocketNose", Vector3.new(22, 5, -22), Vector3.new(6, 8, 8), Color3.fromRGB(216, 91, 73), "WedgePart")
nose.CFrame = CFrame.new(nose.Position) * CFrame.Angles(0, math.rad(90), 0)
local frontWall = part("CabinFront", Vector3.new(18.5, 7, -22), Vector3.new(1, 10, 12), Color3.fromRGB(70, 83, 103))
local function resetTemplate()
    for _, item in slots do
        item.part.Transparency = 0.78
        item.part.CanCollide = false
        item.part:SetAttribute("Placed", false)
        item.outline.Visible = true
    end
end
local strengthStation = part("StrengthGym", Vector3.new(-26, 1, 38), Vector3.new(7, 2, 7), Color3.fromRGB(191, 94, 109))
local speedStation = part("SpeedGym", Vector3.new(26, 1, 38), Vector3.new(7, 2, 7), Color3.fromRGB(110, 115, 218))
local advanced = part("AdvancedGym", Vector3.new(-44, 1, 38), Vector3.new(7, 2, 7), Color3.fromRGB(225, 191, 98))
label(strengthStation, "BENCH PRESS • E to train")
label(speedStation, "TREADMILL • E to train")
label(advanced, "ADVANCED GYM • Requires 1 launch")
local planet = part("MeadowPlanet", Vector3.new(0, 2, -220), Vector3.new(65, 4, 65), Color3.fromRGB(113, 177, 95))
label(planet, "MEADOWS • +3 strength & speed / second for 30 seconds")
world.Parent = workspace

local rocket = Rocket.new(Config, HttpService:GenerateGUID(false))
local function equipment(base, treadmill)
    local p = base.Position
    base.Size = Vector3.new(8, 0.4, 10)
    base.Position = Vector3.new(p.X, 0.2, p.Z)
    local dark, steel = Color3.fromRGB(35, 40, 50), Color3.fromRGB(165, 175, 190)
    if treadmill then
        part("TreadmillBelt", p, Vector3.new(4, 0.5, 7), dark)
        for _, x in {-2.5, 2.5} do
            part("TreadmillRail", p + Vector3.new(x, 0.5, 0), Vector3.new(0.4, 1, 8), steel)
            part("TreadmillPost", p + Vector3.new(x, 2, -3), Vector3.new(0.4, 4, 0.4), steel)
        end
        part("TreadmillConsole", p + Vector3.new(0, 3.5, -3), Vector3.new(5, 1, 0.7), base.Color)
    else
        part("BenchCushion", p + Vector3.new(0, 1, 0), Vector3.new(2.5, 0.6, 6), dark)
        for _, x in {-2.5, 2.5} do
            part("BenchRack", p + Vector3.new(x, 1.5, -2), Vector3.new(0.4, 4, 0.4), steel)
            part("WeightPlate", p + Vector3.new(x, 3, -2), Vector3.new(0.7, 2.2, 2.2), dark)
        end
        part("Barbell", p + Vector3.new(0, 3, -2), Vector3.new(7, 0.25, 0.25), steel)
    end
end
equipment(strengthStation, false)
equipment(speedStation, true)
equipment(advanced, false)
local CargoVisual = require(script.Parent.Services.CargoVisualService)
local function cargoVisual(player)
    local cargo = rocket.cargo[player.UserId]
    CargoVisual.update(player.Character, cargo and cargo.materials, {Metal = metal.Color, Fuel = fuel.Color})
end
local motion, lastAction = {}, {}
local training
local deadline = 0
local boarded = {}
local profiles
local holds = require(script.Parent.Services.HoldService).new(Config.MaterialHoldSeconds)
local lastReject = {}
local function feedback(player, message, rejection)
    feedbackEvent:FireClient(player, message)
    if rejection and os.clock() - (lastReject[player.UserId] or -math.huge) >= 5 then
        lastReject[player.UserId] = os.clock()
        warn("Rocket rejected interaction", player.UserId, rejection)
    end
end
local function speed(profile)
    return math.min(Config.MaxSpeed, Config.BaseSpeed + (profile.speedLevel + profile.planetBonuses.speed) * Config.SpeedPerLevel)
end
local function capacity(profile)
    return math.min(Config.MaxCapacity, 1 + math.floor((profile.strengthLevel + profile.planetBonuses.strength) / 5))
end
local function updateStats(player)
    local record = profiles.records[player.UserId]
    if not record then return end
    local profile = record.profile
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.WalkSpeed = speed(profile) end
    local stats = player:FindFirstChild("leaderstats")
    if stats then
        stats.CompletedLaunches.Value = profile.completedLaunches
        stats.LifetimeDeliveries.Value = profile.lifetimeDeliveries
    end
end
local function send(player)
    local record = profiles.records[player.UserId]
    local profile = record and record.profile
    stateEvent:FireClient(player, {
        phase = rocket.phase, cycle = rocket.cycle, deadline = deadline,
        totals = table.clone(rocket.totals), required = rocket.required, successfulLaunches = rocket.successfulLaunches, slotCost = rocket.slotCost,
        cargo = rocket.cargo[player.UserId], contribution = rocket.contributions[player.UserId] or 0,
        boarded = boarded[player.UserId] == true, passenger = rocket.passengers[player.UserId] == true,
        profile = profile and { strength = profile.strengthLevel + profile.planetBonuses.strength, speed = profile.speedLevel + profile.planetBonuses.speed, completedLaunches = profile.completedLaunches, lifetimeDeliveries = profile.lifetimeDeliveries, walkSpeed = speed(profile), capacity = capacity(profile) },
        saveStatus = record and record.status or "Loading",
        persistent = Config.PersistenceEnabled,
        training = training and training.sessions[player.UserId] and training.sessions[player.UserId].station.name,
    })
end
local function broadcast()
    for _, player in Players:GetPlayers() do send(player) end
end
profiles = Profiles.new(Config, function(userId)
    local player = Players:GetPlayerByUserId(userId)
    if player then updateStats(player); send(player) end
end)

local function finite(vector)
    return vector.X == vector.X and vector.Y == vector.Y and vector.Z == vector.Z and vector.Magnitude < 1e7
end
local function body(player)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 or not finite(root.Position) then return nil end
    return root, humanoid
end
local function observed(player)
    local root = body(player)
    if not root then return nil end
    local sample = motion[player.UserId]
    if not sample or sample.root ~= root or os.clock() < sample.blockedUntil then return nil end
    -- Check again in the interaction handler, covering the gap between samples.
    local delta = root.Position - sample.position
    local elapsed = math.max(0, os.clock() - sample.time)
    if Vector3.new(delta.X, 0, delta.Z).Magnitude > Config.MaxSpeed * elapsed + 3 then return nil end
    return root
end
local function near(player, object)
    local root = observed(player)
    return not (training and training.sessions[player.UserId]) and profiles:ready(player.UserId) and root and object:IsA("BasePart") and object.Anchored and object:IsDescendantOf(world) and (root.Position - object.Position).Magnitude <= Config.InteractionDistance
end
local function insideBoarding(player)
    local root = observed(player)
    if not root or not profiles:ready(player.UserId) then return false end
    local localPosition = boarding.CFrame:PointToObjectSpace(root.Position)
    return math.abs(localPosition.X) <= boarding.Size.X / 2 and math.abs(localPosition.Z) <= boarding.Size.Z / 2 and localPosition.Y >= 0 and localPosition.Y <= 9
end
local function allowed(player, action)
    local now = os.clock()
    local history = lastAction[player.UserId] or {}
    lastAction[player.UserId] = history
    if now - (history[action] or -math.huge) < Config.ActionCooldown then return false end
    history[action] = now
    return true
end
local function relocate(player, position)
    local root = body(player)
    if not root then return end
    player.Character:PivotTo(CFrame.new(position))
    root.AssemblyLinearVelocity = Vector3.zero
    motion[player.UserId] = { root = root, position = root.Position, safe = root.CFrame, time = os.clock(), blockedUntil = os.clock() + 0.5 }
end
local function beginBoarding()
    deadline = workspace:GetServerTimeNow() + Config.BoardingSeconds
    for _, item in prompts do
        if item.Parent == metal or item.Parent == fuel then item.Enabled = false end
    end
    broadcast()
    local cycle = rocket.cycle
    task.delay(Config.BoardingSeconds, function()
        if rocket.cycle ~= cycle or rocket.phase ~= "Boarding" then return end
        local passengers = {}
        for _, player in Players:GetPlayers() do
            if insideBoarding(player) then passengers[player.UserId] = true end
        end
        if not rocket:lockPassengers(passengers) then return end
        boarded = passengers
        deadline = workspace:GetServerTimeNow() + Config.LaunchSeconds
        broadcast()
        for userId in passengers do
            local player = Players:GetPlayerByUserId(userId)
            if player then
                local root = body(player)
                if root then root.Anchored = true end
            end
        end
        task.wait(Config.LaunchSeconds)
        rocket.phase = "Rewarding"
        deadline = workspace:GetServerTimeNow() + Config.RewardSeconds
        for userId in rocket.passengers do

            local player = Players:GetPlayerByUserId(userId)
            if player then
                local root = body(player)
                if root then root.Anchored = false end
                relocate(player, planet.Position + Vector3.new(0, 6, 0))
            end
        end
        broadcast()
        -- Cumulative tick counts are idempotent even when a save retries.
        for tick = 1, Config.RewardSeconds do
            task.wait(1)
            for userId in rocket.passengers do
                profiles:queueReward(userId, cycle, tick)
                local player = Players:GetPlayerByUserId(userId)
                if player then feedback(player, "Meadows +" .. Config.Planet.StrengthBonus .. " strength / +" .. Config.Planet.SpeedBonus .. " speed (" .. tick .. "/" .. Config.RewardSeconds .. ")") end
            end
            broadcast()
        end
        rocket.phase = "Resetting"
        deadline = 0
        broadcast()
        for userId in rocket.passengers do
            local player = Players:GetPlayerByUserId(userId)
            if player then relocate(player, spawn.Position + Vector3.new(0, 5, 0)) end
        end
        task.wait(1)
        rocket = rocket:nextCycle(HttpService:GenerateGUID(false))
        mapCycle += 1
        expandMap(mapCycle)

        for _, player in Players:GetPlayers() do cargoVisual(player) end
        resetTemplate()
        boarded = {}
        for _, item in prompts do item.Enabled = true end
        for _, data in slots do
            data.part:SetAttribute("MaterialsPlaced", 0)
            data.part:SetAttribute("MaterialsRequired", rocket.slotCost)
            data.prompt.ObjectText = data.material .. " section 0/" .. rocket.slotCost
        end
        broadcast()
    end)
end

local function materialNear(player, object)
    local root = observed(player)
    if not root or not profiles:ready(player.UserId) or (training and training.sessions[player.UserId]) then return false end
    if rocket.phase ~= "Building" then return false end
    local point = object.CFrame:PointToObjectSpace(root.Position)
    local half = object.Size / 2
    local closest = Vector3.new(math.clamp(point.X, -half.X, half.X), math.clamp(point.Y, -half.Y, half.Y), math.clamp(point.Z, -half.Z, half.Z))
    return (point - closest).Magnitude <= Config.InteractionDistance
end
local materialTargets, materialCallbacks = {}, {}
local materialHold = Instance.new("RemoteEvent")
materialHold.Name = "MaterialHold"
materialHold.Parent = remotes
local function holdPrompt(object, action, callback)
    local item = prompt(object, action, Config.MaterialHoldSeconds)
    materialTargets[item], materialCallbacks[item] = object, callback
    return item
end
materialHold.OnServerEvent:Connect(function(player, item, holding)
    if holding == false then
        holds:cancel(player.UserId)
        return
    end
    local object = materialTargets[item]
    if holding ~= true or not object or not item.Enabled or not materialNear(player, object) then return end
    local entry = holds.active[player.UserId]
    if entry and entry.target == item and entry.cycle == rocket.cycle then return end
    holds:begin(player.UserId, item, rocket.cycle, os.clock())
end)
for material, source in { Metal = metal, Fuel = fuel } do
    holdPrompt(source, "Pick up " .. material, function(player)
        if rocket:pickup(player.UserId, material, capacity(profiles.records[player.UserId].profile)) then
            cargoVisual(player)
            feedback(player, "Picked up " .. material .. ". Hold E at a matching rocket section.")
            send(player)
        else feedback(player, "Cargo full or this material is complete.") end
    end)
end
local function refreshSlot(id, data)
    local progress = rocket.slotProgress[id] or 0
    local complete = rocket.placedSlots[id] == true
    data.part.Transparency = complete and 0 or 0.78 - 0.4 * progress / rocket.slotCost
    data.part.CanCollide = complete
    data.part:SetAttribute("Placed", complete)
    data.part:SetAttribute("MaterialsPlaced", progress)
    data.part:SetAttribute("MaterialsRequired", rocket.slotCost)
    data.outline.Visible = not complete
    data.prompt.Enabled = rocket.phase == "Building" and not complete
    data.prompt.ObjectText = data.material .. " section " .. progress .. "/" .. rocket.slotCost
end
for id, data in slots do
    data.prompt = holdPrompt(data.part, "Place " .. data.material, function(player)
        if rocket:place(player.UserId, id, data.material) == 0 then
            feedback(player, "Carry " .. data.material .. " for this unfinished section.")
            return
        end
        refreshSlot(id, data)
        cargoVisual(player)
        profiles.records[player.UserId].profile.lifetimeDeliveries += 1
        profiles:dirty(player.UserId)
        updateStats(player)
        feedback(player, data.material .. " section: " .. rocket.slotProgress[id] .. "/" .. rocket.slotCost)
        if rocket.phase == "Boarding" then beginBoarding() else broadcast() end
    end)
    refreshSlot(id, data)
end
-- Repeat on the server while the prompt button remains held.
RunService.Heartbeat:Connect(function()
    local now = os.clock()
    for userId, entry in holds.active do
        local player = Players:GetPlayerByUserId(userId)
        local target = materialTargets[entry.target]
        if not player or not target or not entry.target.Enabled or entry.cycle ~= rocket.cycle
            or not materialNear(player, target) then
            holds:cancel(userId)
        elseif now - entry.started >= Config.MaterialHoldSeconds then
            entry.started = now
            materialCallbacks[entry.target](player)
        end
    end
end)
local discardCargo = Instance.new("RemoteEvent")
discardCargo.Name = "DiscardCargo"
discardCargo.Parent = remotes
discardCargo.OnServerEvent:Connect(function(player)
    if not allowed(player, "discard") or not rocket.cargo[player.UserId] then return end
    rocket.cargo[player.UserId] = nil
    cargoVisual(player)
    feedback(player, "Cargo cleared. Pick up another material.")
    send(player)
end)
training = require(script.Parent.Services.TrainingService).new({
    players = Players, config = Config, profiles = profiles, remotes = remotes,
    prompt = prompt, allowed = allowed, near = near, body = body, relocate = relocate,
    feedback = feedback, changed = function(player) updateStats(player); send(player) end,
    phaseAllowed = function() return rocket.phase == "Building" or rocket.phase == "Boarding" end,
    stations = {
        { part = strengthStation, name = "Bench press", stat = "strengthLevel", gain = 2 },
        { part = speedStation, name = "Treadmill", stat = "speedLevel", gain = 2 },
        { part = advanced, name = "Advanced bench", stat = "strengthLevel", gain = 4, required = Config.AdvancedGymCompletions },
    },
})
local function joined(player)
    local stats = Instance.new("Folder")
    stats.Name = "leaderstats"
    for _, name in { "CompletedLaunches", "LifetimeDeliveries" } do
        local value = Instance.new("IntValue")
        value.Name = name
        value.Parent = stats
    end
    stats.Parent = player
    local function characterAdded(character)
        local root = character:WaitForChild("HumanoidRootPart", 10)
        if not root or player.Character ~= character then return end
        motion[player.UserId] = { root = root, position = root.Position, safe = root.CFrame, time = os.clock(), blockedUntil = os.clock() + 1 }
        updateStats(player)
        cargoVisual(player)
        if rocket.phase == "Rewarding" and rocket.passengers[player.UserId] then relocate(player, planet.Position + Vector3.new(0, 6, 0)) end
    end
    player.CharacterAdded:Connect(characterAdded)
    if player.Character then task.spawn(characterAdded, player.Character) end
    profiles:load(player.UserId)
end
Players.PlayerAdded:Connect(joined)
Players.PlayerRemoving:Connect(function(player)
    holds:cancel(player.UserId)
    training.stop(player)
    rocket:forget(player.UserId)
    if rocket.phase == "Boarding" then boarded[player.UserId] = nil end
    motion[player.UserId], lastAction[player.UserId] = nil, nil
    lastReject[player.UserId] = nil
    profiles:remove(player.UserId)
end)
for _, player in Players:GetPlayers() do task.spawn(joined, player) end
requestState.OnServerEvent:Connect(function(player)
    if allowed(player, "snapshot") then send(player) end
end)
profiles:start()

local sampleElapsed, broadcastElapsed = 0, 0
RunService.Heartbeat:Connect(function(dt)
    sampleElapsed += dt
    broadcastElapsed += dt
    if sampleElapsed < 0.2 then return end
    sampleElapsed = 0
    training.tick(os.clock())
    local now = os.clock()
    for _, player in Players:GetPlayers() do
        local root = body(player)
        local sample = motion[player.UserId]
        if root and sample and sample.root == root then
            local delta = root.Position - sample.position
            if Vector3.new(delta.X, 0, delta.Z).Magnitude > Config.MaxSpeed * (now - sample.time) + 3 then
                root.CFrame = sample.safe
                root.AssemblyLinearVelocity = Vector3.zero
                sample.blockedUntil = now + 2

            end
            sample.position, sample.safe, sample.time = root.Position, root.CFrame, now

        end
        if rocket.phase == "Boarding" then boarded[player.UserId] = insideBoarding(player) end
    end
    if broadcastElapsed >= 1 then broadcastElapsed = 0; broadcast() end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">Services</string>
        <BinaryString name="SerializedOverrides">
        </BinaryString>
      </Properties>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">CargoVisualCheck</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source">return function()
    local visual = require(script.Parent.CargoVisualService)
    local character = Instance.new("Model")
    local root = Instance.new("Part")
    root.Name, root.Anchored, root.Parent = "HumanoidRootPart", true, character
    local colors = {Metal = Color3.fromRGB(139, 166, 185), Fuel = Color3.fromRGB(245, 182, 71)}
    local previousRadius = -1
    for _, count in {1, 2, 5, 10, 25, 100} do
        visual.update(character, {Metal = math.ceil(count / 2), Fuel = math.floor(count / 2)}, colors)
        local model = assert(character:FindFirstChild("CarriedMaterials"))
        assert(#model:GetChildren() == count, "Every held item must be visible")
        local radius = 0.85 * (count - 1) ^ (1 / 3)
        local center = Vector3.new(0, 0.3 + radius * 0.2, -2 - radius)
        local outer = 0
        for _, block in model:GetChildren() do
            local position = root.CFrame:PointToObjectSpace(block.Position)
            outer = math.max(outer, (position - center).Magnitude)
            assert(position.Z &lt;= -1.99, "Cargo must stay in front")
            assert(not block.CanCollide and not block.CanTouch and not block.CanQuery and block.Massless)
            local weld = assert(block:FindFirstChildOfClass("WeldConstraint"))
            assert(weld.Part0 == root and weld.Part1 == block)
        end
        assert(outer &gt; previousRadius, "Mass must expand with more cargo")
        previousRadius = outer
    end
    visual.update(character, {Metal = 1}, colors)
    assert(#character.CarriedMaterials:GetChildren() == 1, "Delivery must shrink the mass")
    visual.update(character, nil, colors)
    assert(not character:FindFirstChild("CarriedMaterials"), "Clearing must remove the mass")
    visual.update(character, {Metal = 0, Fuel = 0}, colors)
    assert(not character:FindFirstChild("CarriedMaterials"))
    character:Destroy()
    return "Cargo checks passed: mixed materials, growth 1–100, shrinking, clearing, welds, and collisions"
end</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">CargoVisualService</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[local CargoVisual = {}

function CargoVisual.update(character, materials, colors)
    if not character then return end
    local previous = character:FindFirstChild("CarriedMaterials")
    if previous then previous:Destroy() end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not materials or not root then return end
    local count = (materials.Metal or 0) + (materials.Fuel or 0)
    if count == 0 then return end
    local radius = 0.85 * (count - 1) ^ (1 / 3)
    local center = Vector3.new(0, 0.3 + radius * 0.2, -2 - radius)
    local model = Instance.new("Model")
    model.Name = "CarriedMaterials"
    local index = 0
    for _, material in {"Metal", "Fuel"} do
        for _ = 1, materials[material] or 0 do
            index += 1
            local offset = Vector3.zero
            if index > 1 then
                local distance = 0.85 * (index - 1) ^ (1 / 3)
                local y = 1 - 2 * ((index * 0.61803398875) % 1)
                local angle = index * 2.39996322973
                local ring = math.sqrt(1 - y * y)
                offset = Vector3.new(math.cos(angle) * ring, y, math.sin(angle) * ring) * distance
            end
            local block = Instance.new("Part")
            block.Name = material
            block.Size = Vector3.new(1.5, 1.2, 1.5)
            block.Color = colors[material]
            block.CanCollide, block.CanTouch, block.CanQuery, block.Massless = false, false, false, true
            block.CFrame = root.CFrame * CFrame.new(center + offset)
                * CFrame.Angles(math.sin(index * 2) * 0.25, index * 2.39996322973, math.cos(index * 3) * 0.25)
            block.Parent = model
            local weld = Instance.new("WeldConstraint")
            weld.Part0, weld.Part1, weld.Parent = root, block, block
        end
    end
    model.Parent = character
end

return CargoVisual
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">HoldService</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[local Hold = {}
Hold.__index = Hold
function Hold.new(duration)
    return setmetatable({ duration = duration, active = {} }, Hold)
end
function Hold:begin(id, target, cycle, now)
    self.active[id] = { target = target, cycle = cycle, started = now }
end
function Hold:ended(id, target)
    local entry = self.active[id]
    if entry and entry.target == target then self.active[id] = nil end
end
function Hold:cancel(id) self.active[id] = nil end
return Hold
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">MapExpansionService</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[-- Map space grows every three cycles; rocket construction remains separate.
local Map = {}
function Map.build(part, label)
    local grass = Color3.fromRGB(62, 103, 72)
    local concrete = Color3.fromRGB(81, 91, 107)
    local paint = Color3.fromRGB(245, 182, 71)
    part("Ground", Vector3.new(0, -1, -45), Vector3.new(240, 2, 230), grass)
    part("LaunchApron", Vector3.new(0, -0.25, -22), Vector3.new(160, 0.5, 100), concrete)
    local sign = part("ExpansionSign", Vector3.new(0, 0.1, 60), Vector3.new(12, 0.2, 4), paint)
    label(sign, "SPACEPORT • New construction bays every 3 cycles")
    -- Flat markings leave the cabin entrance and future boosters unobstructed.
    for _, z in {-72, 28} do
        part("ApronMarking", Vector3.new(0, 0.02, z), Vector3.new(160, 0.04, 1), paint).CanCollide = false
    end
    local stage = 0
    return function(cycle)
        local target = math.floor((cycle - 1) / 3)
        for index = stage + 1, target do
            for _, side in {-1, 1} do
                part("ExpansionGround" .. index .. "_" .. side,
                    Vector3.new(side * (80 + index * 80), -1, -45), Vector3.new(80, 2, 230), grass)
                local bay = part("ConstructionBay" .. index .. "_" .. side,
                    Vector3.new(side * (40 + index * 80), -0.25, -22), Vector3.new(80, 0.5, 100), concrete)
                label(bay, "EXPANSION " .. index .. " • Booster / rocket space")
                for _, z in {-72, 28} do
                    part("BayMarking", Vector3.new(bay.Position.X, 0.02, z),
                        Vector3.new(80, 0.04, 1), paint).CanCollide = false
                end
            end
            if index % 10 == 0 then task.wait() end
        end
        stage = math.max(stage, target)
    end
end
return Map
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">MaterialInteractionCheck</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source">return function()
    local Rocket = require(script.Parent.RocketService)
    local Hold = require(script.Parent.HoldService)
    local config = require(game.ReplicatedStorage.Shared.Config)
    assert(config.MaterialHoldSeconds == 0.05)
    local rocket = Rocket.new(config, "check", 1)
    assert(rocket:pickup(1, "Metal", 3))
    assert(rocket:pickup(1, "Fuel", 3))
    assert(rocket:pickup(1, "Metal", 3))
    assert(not rocket:pickup(1, "Fuel", 3))
    assert(rocket.cargo[1].count == 3)
    assert(rocket:place(1, "wall", "Metal") == 1)
    assert(rocket:place(1, "wall", "Metal") == 1)
    assert(rocket:place(1, "wall", "Metal") == 0)
    assert(rocket.cargo[1].materials.Fuel == 1 and rocket.cargo[1].count == 1)
    assert(rocket:place(1, "engine", "Fuel") == 1)
    assert(rocket.cargo[1] == nil)
    local holds = Hold.new(0.05)
    holds:begin(1, "prompt", "cycle", 0)
    assert(holds.active[1].started == 0 and holds.duration == 0.05)
    holds:ended(1, "other")
    assert(holds.active[1])
    holds:ended(1, "prompt")
    assert(not holds.active[1])
    return "Mixed pickup, shared capacity, matching placement, empty cargo, and release checks passed"
end</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">ProfileService</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Profiles = {}
Profiles.__index = Profiles

local function defaults()
    return { schemaVersion = 1, strengthLevel = 0, speedLevel = 0, planetBonuses = { strength = 0, speed = 0 }, completedLaunches = 0, lifetimeDeliveries = 0, rewardedLaunchIds = {} }
end

local function copy(profile)
    local result = table.clone(profile)
    result.planetBonuses = table.clone(profile.planetBonuses)
    result.rewardedLaunchIds = table.clone(profile.rewardedLaunchIds)
    result.rewardedLaunchTicks = table.clone(profile.rewardedLaunchTicks or {})
    return result
end

local function validate(raw, config)
    if raw == nil then return defaults() end
    if type(raw) ~= "table" or raw.schemaVersion ~= 1 then error("Unsupported profile schema; refusing overwrite") end
    for _, key in { "strengthLevel", "speedLevel", "completedLaunches", "lifetimeDeliveries" } do
        local value = raw[key]
        if type(value) ~= "number" or value ~= value or value == math.huge or value < 0 or value % 1 ~= 0 then error("Invalid profile " .. key) end
    end
    if type(raw.planetBonuses) ~= "table" or type(raw.rewardedLaunchIds) ~= "table" then error("Invalid profile collections") end
    for _, key in { "strength", "speed" } do
        local value = raw.planetBonuses[key]
        if type(value) ~= "number" or value ~= value or value == math.huge or value < 0 or value % 1 ~= 0 then error("Invalid bonus") end
    end
    if raw.strengthLevel > config.MaxLevel or raw.speedLevel > config.MaxLevel then error("Invalid stat cap") end
    for _, id in raw.rewardedLaunchIds do if type(id) ~= "string" then error("Invalid reward ledger") end end
    if raw.rewardedLaunchTicks ~= nil then
        if type(raw.rewardedLaunchTicks) ~= "table" then error("Invalid reward ticks") end
        for id, ticks in raw.rewardedLaunchTicks do
            if type(id) ~= "string" or type(ticks) ~= "number" or ticks ~= ticks or ticks < 0 or ticks % 1 ~= 0 or ticks == math.huge then error("Invalid reward ticks") end
        end
    end
    local result = copy(raw)
    for _, id in result.rewardedLaunchIds do
        if result.rewardedLaunchTicks[id] == nil then result.rewardedLaunchTicks[id] = 1 end
    end
    return result
end

function Profiles.new(config, changed)
    return setmetatable({ config = config, changed = changed, records = {}, owner = HttpService:GenerateGUID(false), store = config.PersistenceEnabled and DataStoreService:GetDataStore(config.DataStoreName) or nil }, Profiles)
end

function Profiles:load(userId)
    local previous = self.records[userId]
    if previous and not string.find(previous.status, "Load failed", 1, true) then
        while previous.busy do task.wait(0.1) end
        previous.leaving = false
        self.changed(userId)
        return not previous.blocked
    end
    local record = { profile = defaults(), pending = {}, status = "Loading", busy = true, leaving = false }
    self.records[userId] = record
    local ok, profile = pcall(function()
        if not self.store then return defaults() end
        local now = os.time()
        return self.store:UpdateAsync("Player_" .. userId, function(raw)
            local current = validate(raw, self.config)
            if current.session and current.session.owner ~= self.owner and current.session.expires > now then return nil end
            current.session = { owner = self.owner, expires = now + self.config.LeaseSeconds }
            return current
        end)
    end)
    record.busy = false
    if not ok or not profile then
        record.status = "Load failed — rejoin; progress disabled"
        warn("Rocket profile load failed", userId, ok and "Profile in use" or tostring(profile))
        self.changed(userId)
        return false
    end
    record.profile = profile
    record.status = self.store and "Saved" or "Studio only — progress is not permanent"
    self.changed(userId)
    return true
end

function Profiles:ready(userId)
    local record = self.records[userId]
    return record and not record.blocked and not record.leaving and record.status ~= "Loading" and not string.find(record.status, "Load failed", 1, true)
end

function Profiles:dirty(userId)
    local record = self.records[userId]
    record.dirty = true
    if self.store and not next(record.pending) then record.status = "Unsaved changes — autosave pending" end
end

function Profiles:queueReward(userId, launchId, ticks)
    local record = self.records[userId]
    if not record or record.status == "Loading" or string.find(record.status, "Load failed", 1, true) then return end
    record.pending[launchId] = math.max(record.pending[launchId] or 0, ticks or 1)
    record.status = "Reward pending — saving"
    self.changed(userId)
    task.spawn(function() self:save(userId) end)
end

function Profiles:save(userId)
    local record = self.records[userId]
    if not record or record.busy or record.status == "Loading" or string.find(record.status, "Load failed", 1, true) then return false end
    record.busy = true
    local snapshot = copy(record.profile)
    local batch = {}
    local batchCount = 0
    for id, ticks in record.pending do
        if batchCount >= self.config.RecentRewardLimit then break end
        batch[id] = ticks
        batchCount += 1
    end
    local function applyRewards(profile)
        profile.rewardedLaunchTicks = profile.rewardedLaunchTicks or {}
        for id, ticks in batch do
            local previous = profile.rewardedLaunchTicks[id] or (table.find(profile.rewardedLaunchIds, id) and 1 or 0)
            local delta = math.max(0, ticks - previous)
            if not table.find(profile.rewardedLaunchIds, id) then
                profile.completedLaunches += 1
                table.insert(profile.rewardedLaunchIds, id)
            end
            local cap = self.config.MaxPlanetBonus or self.config.MaxLevel
            profile.planetBonuses.strength = math.min(cap, profile.planetBonuses.strength + delta * self.config.Planet.StrengthBonus)
            profile.planetBonuses.speed = math.min(cap, profile.planetBonuses.speed + delta * self.config.Planet.SpeedBonus)
            profile.rewardedLaunchTicks[id] = math.max(previous, ticks)
        end
        while #profile.rewardedLaunchIds > self.config.RecentRewardLimit do
            -- Never evict an ID in this transaction's retry batch.
            for index, id in profile.rewardedLaunchIds do
                if not batch[id] then profile.rewardedLaunchTicks[id] = nil; table.remove(profile.rewardedLaunchIds, index); break end
            end
        end
        return profile
    end
    local ok, saved
    for attempt = 1, 3 do
        ok, saved = pcall(function()
            if not self.store then return applyRewards(copy(snapshot)) end
            return self.store:UpdateAsync("Player_" .. userId, function(raw)
                local current = validate(raw, self.config)
                if not current.session or current.session.owner ~= self.owner then return nil end
                -- Retain the stored reward ledger after an ambiguous previous write.
                current.strengthLevel = snapshot.strengthLevel
                current.speedLevel = snapshot.speedLevel
                current.lifetimeDeliveries = snapshot.lifetimeDeliveries
                applyRewards(current)
                current.session = { owner = self.owner, expires = os.time() + self.config.LeaseSeconds }
                return current
            end)
        end)
        if ok and saved then break end
        if attempt < 3 then task.wait(2 ^ attempt) end
    end
    record.busy = false
    if ok and saved then
        -- Preserve training/deliveries earned while UpdateAsync was yielding.
        record.profile.completedLaunches = saved.completedLaunches
        record.profile.planetBonuses = saved.planetBonuses
        record.profile.rewardedLaunchIds = saved.rewardedLaunchIds
        record.profile.rewardedLaunchTicks = saved.rewardedLaunchTicks
        for id, ticks in batch do if record.pending[id] <= ticks then record.pending[id] = nil end end
        record.dirty = record.profile.strengthLevel ~= snapshot.strengthLevel or record.profile.speedLevel ~= snapshot.speedLevel or record.profile.lifetimeDeliveries ~= snapshot.lifetimeDeliveries
        record.status = next(record.pending) and "Reward pending — saving" or (self.store and (record.dirty and "Unsaved changes — autosave pending" or "Saved") or "Studio only — progress is not permanent")
        if record.leaving and not next(record.pending) and not record.dirty then
            -- Keep lease until expiry: protects a disconnected locked passenger.
            -- Rejoining another server may wait up to LeaseSeconds.
            record.status = self.store and "Saved — session expires shortly" or record.status
        end
    else
        record.dirty = true
        if ok and saved == nil then record.blocked = true end
        record.status = next(record.pending) and "Reward pending — save failed; retrying" or "Save failed — retrying"
        if record.blocked then record.status = "Save blocked — session ownership lost; progress disabled" end
        warn("Rocket save failed", userId, ok and "Session ownership lost" or tostring(saved))
    end
    self.changed(userId)
    return ok and saved ~= nil
end

function Profiles:remove(userId)
    local record = self.records[userId]
    if not record then return end
    record.leaving = true
    record.dirty = true
    task.spawn(function() self:save(userId) end)
end

function Profiles:start()
    -- ponytail: retain disconnected records for late locked rewards; prune after
    -- cycle completion if long-lived servers make historical player count large.
    task.spawn(function()
        while true do
            task.wait(self.config.AutosaveSeconds)
            for userId, record in self.records do
                if not record.leaving or record.dirty or next(record.pending) then task.spawn(function() self:save(userId) end) end
            end
        end
    end)
    game:BindToClose(function()
        local left = 0
        for userId in self.records do
            left += 1
            task.spawn(function()
                local record = self.records[userId]
                while record.busy do task.wait(0.1) end
                self:save(userId)
                left -= 1
            end)
        end
        local deadline = os.clock() + 25
        while left > 0 and os.clock() < deadline do task.wait(0.1) end
    end)
end

return Profiles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">RocketService</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[-- This module never yields: validation, spending and phase transition are atomic.
local Rocket = {}
Rocket.__index = Rocket

function Rocket.new(config, id, successfulLaunches)
    local self = setmetatable({ config = config, cycle = id, phase = "Building", totals = {}, cargo = {}, contributions = {}, passengers = {}, placedSlots = {} }, Rocket)
    self.successfulLaunches = successfulLaunches or 0
    self.slotCost = 1 + self.successfulLaunches * (config.MaterialsPerSlotPerLaunch or 1)
    self.required, self.slotProgress = {}, {}
    for material, base in config.Materials do
        self.totals[material] = 0
        self.required[material] = base * self.slotCost
    end
    return self
end

function Rocket:pickup(userId, material, capacity)
    if self.phase ~= "Building" or type(material) ~= "string" or not self.required[material] then return false end
    if self.totals[material] >= self.required[material] then return false end
    local cargo = self.cargo[userId]
    if cargo and cargo.count >= capacity then return false end
    cargo = cargo or { count = 0, materials = {} }
    cargo.count += 1
    cargo.materials[material] = (cargo.materials[material] or 0) + 1
    self.cargo[userId] = cargo
    return true
end

function Rocket:deliver(userId)
    if self.phase ~= "Building" then return 0 end
    local cargo = self.cargo[userId]
    if not cargo then return 0 end
    local accepted = 0
    for material, count in cargo.materials do
        local amount = math.min(count, self.required[material] - self.totals[material])
        self.totals[material] += amount
        cargo.materials[material] -= amount
        cargo.count -= amount
        accepted += amount
    end
    if cargo.count == 0 then self.cargo[userId] = nil end
    self.contributions[userId] = (self.contributions[userId] or 0) + accepted
    for material, required in self.required do
        if self.totals[material] < required then return accepted end
    end
    self.phase = "Boarding"
    return accepted
end

-- A slot is spent once, in the same non-yielding transaction as its cargo.
function Rocket:place(userId, slotId, material)
    if self.phase ~= "Building" or self.placedSlots[slotId] or not self.required[material] then return 0 end
    local cargo = self.cargo[userId]
    if not cargo or (cargo.materials[material] or 0) < 1 or self.totals[material] >= self.required[material] then return 0 end
    self.slotProgress[slotId] = (self.slotProgress[slotId] or 0) + 1
    self.placedSlots[slotId] = self.slotProgress[slotId] >= self.slotCost
    self.totals[material] += 1
    cargo.materials[material] -= 1
    cargo.count -= 1
    if cargo.count == 0 then self.cargo[userId] = nil end
    self.contributions[userId] = (self.contributions[userId] or 0) + 1
    for key, required in self.required do
        if self.totals[key] < required then return 1 end
    end
    self.phase = "Boarding"
    return 1
end
function Rocket:lockPassengers(eligible)
    if self.phase ~= "Boarding" then return false end
    self.passengers = table.clone(eligible)
    self.phase = "Launching"
    return true
end

-- Only a locked, nonempty passenger list counts as a successful blast off.
function Rocket:nextCycle(id)
    assert(self.phase == "Resetting", "Reset only after the launch sequence")
    local successes = self.successfulLaunches + (next(self.passengers) and 1 or 0)
    return Rocket.new(self.config, id, successes)
end
function Rocket:forget(userId)
    self.cargo[userId] = nil
    -- Keep a locked passenger's entitlement even after disconnect.
    if self.phase == "Boarding" then self.passengers[userId] = nil end
end

return Rocket
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">TrainingService</string>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[-- Server-owned mounting and timed gains. Clients can only request an exit.
local Training = {}
function Training.new(context)
    local sessions, lastExit = {}, {}
    local function stop(player)
        local session = sessions[player.UserId]
        if not session then return end
        sessions[player.UserId] = nil
        lastExit[player.UserId] = os.clock()
        session.station.occupant = nil
        if session.root.Parent then
            session.root.Anchored = session.anchored
            session.humanoid.AutoRotate = session.autoRotate
            session.humanoid.Sit = false
            if player.Character == session.character then
                context.relocate(player, session.station.part.Position + Vector3.new(5, 4, 0))
            end
        end
        context.changed(player)
    end
    local exit = Instance.new("RemoteEvent")
    exit.Name = "ExitTraining"
    exit.Parent = context.remotes
    exit.OnServerEvent:Connect(function(player) stop(player) end)
    local stations = context.stations
    for _, station in stations do
        context.prompt(station.part, "Train " .. station.name).Triggered:Connect(function(player)
            if os.clock() - (lastExit[player.UserId] or -math.huge) < 1 then return end
            if sessions[player.UserId] or not context.allowed(player, "train") or not context.near(player, station.part) then return end
            if not context.phaseAllowed() then return end
            if station.occupant then context.feedback(player, "Station occupied."); return end
            local profile = context.profiles.records[player.UserId].profile
            if profile.completedLaunches < (station.required or 0) then context.feedback(player, "Complete one launch to unlock this bench."); return end
            if profile[station.stat] >= context.config.MaxLevel then context.feedback(player, "Playtest level cap reached."); return end
            local root, humanoid = context.body(player)
            if not root then return end
            station.occupant = player
            sessions[player.UserId] = { station = station, root = root, humanoid = humanoid, character = player.Character,
                anchored = root.Anchored, autoRotate = humanoid.AutoRotate, nextTick = os.clock() + context.config.TrainingSeconds }
            context.relocate(player, station.part.Position + Vector3.new(0, station.stat == "speedLevel" and 4 or 3, 0))
            root.Anchored = true
            humanoid.AutoRotate = false
            humanoid.Sit = station.stat == "strengthLevel"
            context.feedback(player, station.name .. ": training! Press E or Leave station to exit.")
            context.changed(player)
        end)
    end
    local service = { sessions = sessions, stop = stop }
    function service.tick(now)
        for userId, session in sessions do
            local player = context.players:GetPlayerByUserId(userId)
            if player then
                if player.Character ~= session.character or session.humanoid.Health <= 0 or not session.root.Parent
                    or not context.profiles:ready(userId) or not context.phaseAllowed()
                    or (session.root.Position - session.station.part.Position).Magnitude > 7 then
                    stop(player)
                elseif now >= session.nextTick then
                    session.nextTick = now + context.config.TrainingSeconds
                    local profile = context.profiles.records[userId].profile
                    local stat = session.station.stat
                    local gain = math.min(session.station.gain, context.config.MaxLevel - profile[stat])
                    profile[stat] += gain
                    context.profiles:dirty(userId)
                    context.feedback(player, "+" .. gain .. " " .. (stat == "strengthLevel" and "Strength" or "Speed") .. "!")
                    context.changed(player)
                    if profile[stat] >= context.config.MaxLevel then
                        stop(player)
                        context.feedback(player, "Level cap reached! Try your upgraded stats.")
                    end
                end
            end
        end
    end
    return service
end
return Training

]]></string>
        </Properties>
      </Item>
    </Item>
